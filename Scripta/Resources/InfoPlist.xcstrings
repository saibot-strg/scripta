{
  "sourceLanguage" : "de",
  "strings" : {
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scripta nimmt über das Mikrofon auf, damit du Sprachnotizen und Gespräche später transkribieren kannst. Die Aufnahmen bleiben auf deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripta records from the microphone so you can transcribe voice notes and conversations later. Recordings stay on your Mac."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scripta nimmt in Meetings den Ton anderer Apps auf, damit „Ich“ und „Andere“ getrennt transkribiert werden können. Die Aufnahmen bleiben auf deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripta records the sound of other apps during meetings so “Me” and “Others” can be transcribed separately. Recordings stay on your Mac."
          }
        }
      }
    }
  },
  "version" : "1.0"
}