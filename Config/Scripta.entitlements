<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox is always on. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Files and folders chosen by the user (import, export, storage location via security-scoped bookmark). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remember a chosen storage folder across launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Outgoing connections, used only to download the speech model once (Hugging Face). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Microphone recording (also required by the Hardened Runtime). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
